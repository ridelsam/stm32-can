.DEFAULT_GOAL := all
.DELETE_ON_ERROR:

TARGET := stm32-can
CONFIG ?= Debug

# build.sh supplies an absolute prefix; direct make can use tools on PATH.
CROSS_COMPILE ?= arm-none-eabi-
CC := $(CROSS_COMPILE)gcc
OBJCOPY := $(CROSS_COMPILE)objcopy
SIZE := $(CROSS_COMPILE)size

LINKER_SCRIPT := STM32F446RETx_FLASH.ld
override BUILD_DIR := build/$(CONFIG)
ELF := $(BUILD_DIR)/$(TARGET).elf
BIN := $(BUILD_DIR)/$(TARGET).bin
MAP := $(BUILD_DIR)/$(TARGET).map

# New C files directly inside these directories are included automatically.
C_SOURCES := $(sort $(wildcard Src/*.c Drivers/STM32F4xx_HAL_Driver/Src/*.c))
ASM_SOURCES := startup/startup_stm32f446xx.s
OBJECTS := $(addprefix $(BUILD_DIR)/,$(C_SOURCES:.c=.o) $(ASM_SOURCES:.s=.o))
DEPENDENCIES := $(OBJECTS:.o=.d)

INCLUDE_DIRS := \
	Inc \
	Drivers/STM32F4xx_HAL_Driver/Inc \
	Drivers/STM32F4xx_HAL_Driver/Inc/Legacy \
	Drivers/CMSIS/Device/ST/STM32F4xx/Include \
	Drivers/CMSIS/Include

# Keep the oscillator declaration consistent across translation units.
DEFINES := USE_HAL_DRIVER STM32F446xx HSE_VALUE=8000000U
CPPFLAGS := $(addprefix -I,$(INCLUDE_DIRS)) $(addprefix -D,$(DEFINES))

MCU_FLAGS := -mcpu=cortex-m4 -mthumb -mfpu=fpv4-sp-d16 -mfloat-abi=hard

ifeq ($(CONFIG),Debug)
CONFIG_FLAGS := -Og -g3
else ifeq ($(CONFIG),Release)
CONFIG_FLAGS := -Os -g3
else
$(error Unsupported CONFIG "$(CONFIG)"; use Debug or Release)
endif

CFLAGS := $(MCU_FLAGS) $(CONFIG_FLAGS) -std=gnu11 -Wall \
	-ffunction-sections -fdata-sections -MMD -MP --specs=nano.specs
ASFLAGS := $(MCU_FLAGS) -g3 -x assembler-with-cpp -MMD -MP
LDFLAGS := $(MCU_FLAGS) -T$(LINKER_SCRIPT) \
	--specs=nano.specs --specs=nosys.specs \
	-Wl,-Map=$(MAP) -Wl,--gc-sections
LDLIBS := -Wl,--start-group -lc -lm -Wl,--end-group

.PHONY: all size clean clean-all
all: $(ELF) $(BIN) size

# Relink when an object, the memory layout, or build settings change.
$(ELF): $(OBJECTS) $(LINKER_SCRIPT) Makefile toolchain.conf
	@mkdir -p "$(dir $@)"
	"$(CC)" $(OBJECTS) $(LDFLAGS) $(LDLIBS) -o "$@"

$(BIN): $(ELF)
	"$(OBJCOPY)" -O binary "$<" "$@"

size: $(ELF)
	"$(SIZE)" "$<"

# Preserve source directories under build/ to avoid object-name collisions.
$(BUILD_DIR)/%.o: %.c Makefile toolchain.conf
	@mkdir -p "$(dir $@)"
	"$(CC)" $(CPPFLAGS) $(CFLAGS) -c "$<" -o "$@"

$(BUILD_DIR)/%.o: %.s Makefile toolchain.conf
	@mkdir -p "$(dir $@)"
	"$(CC)" $(CPPFLAGS) $(ASFLAGS) -c "$<" -o "$@"

clean:
	rm -rf "$(BUILD_DIR)"

clean-all:
	rm -rf build/Debug build/Release

# Header dependencies generated by GCC; absent on the first build.
-include $(DEPENDENCIES)
